# KitchenSync — Simulator / Dashboard image
#
# Shared base image for the POS simulator and Streamlit dashboard.
# There is no ingest API anymore (2026-08) — the simulator batches live
# events in memory and writes directly to Neon with short-lived
# connections every FLUSH_INTERVAL_SECONDS, instead of POSTing to a
# FastAPI service. That service previously held a Neon connection open
# 24/7 and, combined with the simulator's own always-on connection,
# exhausted the Neon free tier's monthly compute-hours in about a week.
# Production deployment uses EC2 + systemd; this image is provided for
# containerized environments. See docker-compose.yml for the full stack.
#
# Note: the ML pipeline (extract → dbt → predict) and nightly A/B comparison
# run as a cron job outside Docker and are not included here.
#
# Note: Snowflake RSA key auth requires mounting the private key into the
# container. See docker-compose.yml for the volume configuration.

FROM python:3.12-slim

WORKDIR /app

# Install uv for fast, reproducible dependency resolution
RUN pip install uv

# Copy dependency manifests first — Docker caches this layer separately
# so `uv sync` only reruns when dependencies actually change
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY . .

EXPOSE 8501

CMD ["uv", "run", "streamlit", "run", "dashboard/app.py", "--server.port", "8501", "--server.address", "0.0.0.0"]
